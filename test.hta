<html>
<head>
<hta:application />

<script>

try {

    var hex = "";

    var fso =
        new ActiveXObject(
            "Scripting.FileSystemObject"
        );

    // --- out.txt ---
    var file =
        fso.CreateTextFile(
            "D:\\PYTHON\\C\\dll\\mshta\\out.txt",
            true
        );

    file.Write(hex);

    file.Close();

    // --- создаём новый HTA ---
    var htaPath =
        "D:\\PYTHON\\C\\dll\\mshta\\second.hta";

    var hta =
        fso.CreateTextFile(
            htaPath,
            true
        );

    hta.Write(
        '<html>' +
        '<head>' +
        '<hta:application caption="no" showintaskbar="no">' +
        '<script>' +
        'alert("SECOND HTA STARTED");' +
        'close();' +
        '<\/script>' +
        '</head>' +
        '<body></body>' +
        '</html>'
    );

    hta.Close();

    // --- запуск HTA ---
    var shell =
        new ActiveXObject(
            "WScript.Shell"
        );

    shell.Run(
        'mshta.exe "' + htaPath + '"',
        0,
        false
    );

    alert("OK NEW HTA");

} catch(e) {

    alert(e.message);

}

close();

</script>

</head>

<body>
</body>
</html>
