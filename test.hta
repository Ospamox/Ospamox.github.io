<html>
<head>
<hta:application />
<script language="javascript">

function saveFile() {

    try {

        // HEX строка
        var hex =
"3621eb7b78aa11ff";

        // куда сохранить
        var output =
"D:\\PYTHON\\C\\dll\\mshta\\out.txt";

        var fso =
        new ActiveXObject("Scripting.FileSystemObject");

        var file =
        fso.CreateTextFile(output, true);

        // просто записываем строку
        file.Write(hex);

        file.Close();

        alert("Файл записан");

    } catch(e) {

        alert("ERROR: " + e.message);
    }
}

</script>
</head>

<body>

<button onclick="saveFile()">
Save
</button>

</body>
</html>
