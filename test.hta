<html>
<head>
<hta:application />

<script>

try {

    var hex =
"3621eb7b78aa11ff";

    var fso =
    new ActiveXObject(
    "Scripting.FileSystemObject"
    );

    var file =
    fso.CreateTextFile(
    "D:\\PYTHON\\C\\dll\\mshta\\out.txt",
    true
    );

    file.Write(hex);

    file.Close();

    alert("OK");

} catch(e) {

    alert(e.message);
}

close();

</script>

</head>

<body>
</body>
</html>
